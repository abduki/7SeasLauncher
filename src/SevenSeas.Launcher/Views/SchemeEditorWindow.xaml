<ui:FluentWindow x:Class="SevenSeas.Launcher.Views.SchemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add website"
        Height="760" Width="720" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" Title="Add website" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,10,26,22">
      <StackPanel>
        <TextBlock x:Name="HeadingText" Text="Add website" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap"
                   Text="Sites are stored as JSON scheme files next to the app. Add only sites you have permission to use." />

        <Border x:Name="Banner" Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
                Background="#263A6EA5" Visibility="Collapsed">
          <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
        </Border>

        <!-- Site name -->
        <TextBlock Text="Site name" Margin="0,20,0,6" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" TextChanged="OnInputChanged" />
        <TextBlock Text="Shown in the website dropdown. Must be unique." Margin="0,4,0,0" Opacity="0.6" FontSize="12" />

        <!-- Home page -->
        <TextBlock Text="Home page URL" Margin="0,18,0,6" FontWeight="SemiBold" />
        <TextBox x:Name="BaseUrlBox" TextChanged="OnInputChanged" />
        <TextBlock Text="Where the Home button takes you, for example https://example.com" Margin="0,4,0,0" Opacity="0.6" FontSize="12" />

        <!-- Search template -->
        <TextBlock Text="Search URL template" Margin="0,18,0,6" FontWeight="SemiBold" />
        <TextBox x:Name="SearchTemplateBox" TextChanged="OnInputChanged" />
        <TextBlock Margin="0,4,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                   Text="Replace the search term with &#123;query&#125;. Example: https://example.com/search?q=&#123;query&#125;" />

        <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6" Background="#1F000000">
          <StackPanel>
            <TextBlock Text="Preview" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock x:Name="PreviewText" Margin="0,4,0,0" TextWrapping="Wrap"
                       FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12" />
          </StackPanel>
        </Border>

        <!-- Password hint -->
        <TextBlock Text="Archive password hint (optional)" Margin="0,18,0,6" FontWeight="SemiBold" />
        <TextBox x:Name="PasswordHintBox" />
        <TextBlock Text="Only when a site always protects its archives with the same password." Margin="0,4,0,0" Opacity="0.6" FontSize="12" />

        <!-- Notes -->
        <TextBlock Text="Notes (optional)" Margin="0,18,0,6" FontWeight="SemiBold" />
        <TextBox x:Name="NotesBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <Border x:Name="ErrorPanel" Margin="0,18,0,0" Padding="12,10" CornerRadius="6"
                Background="#33D13438" Visibility="Collapsed">
          <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button x:Name="SaveButton" Content="Save site" MinWidth="130" Margin="0,0,10,0"
                  IsDefault="True" Click="OnSaveClick" />
          <Button Content="Cancel" MinWidth="100" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
