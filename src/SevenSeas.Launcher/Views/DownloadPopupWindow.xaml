<ui:FluentWindow x:Class="SevenSeas.Launcher.Views.DownloadPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="New window"
        Height="740" Width="1020" MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="PopupTitleBar" Title="New window" />

    <!-- A new window is somewhere you can browse and bookmark, not just somewhere a download lands. -->
    <Border Grid.Row="1" Padding="8,6" Background="#14000000">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Click="OnOpenInMainClick" ToolTip="Open this page in the main window"
                  AutomationProperties.Name="Open in main window">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowExportUp24" Margin="0,0,6,0" />
              <TextBlock Text="Open in main window" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Button DockPanel.Dock="Left" Click="OnSavePageClick"
                ToolTip="Add the page you are on here as a bookmark"
                AutomationProperties.Name="Save this page">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
            <TextBlock Text="Save this page" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <TextBlock x:Name="AddressText" Margin="12,0,12,0" VerticalAlignment="Center"
                   Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Padding="12,6" Background="#0D000000">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,8,0" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="Opening…" />
        <ProgressBar x:Name="Progress" Width="120" Height="6" Margin="12,0,0,0"
                     VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <wv2:WebView2 x:Name="Web" Grid.Row="3" />
  </Grid>
</ui:FluentWindow>
