<UserControl x:Class="SevenSeas.Launcher.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Navigation and search: the browser basics people expect to find here. -->
    <Border Grid.Row="0" Padding="6" Background="#1A000000">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Width="36" Margin="0,0,4,0" Click="OnBackClick"
                  ToolTip="Back" AutomationProperties.Name="Back">
            <ui:SymbolIcon Symbol="ArrowLeft24" />
          </Button>
          <Button x:Name="ForwardButton" Width="36" Margin="0,0,4,0" Click="OnForwardClick"
                  ToolTip="Forward" AutomationProperties.Name="Forward">
            <ui:SymbolIcon Symbol="ArrowRight24" />
          </Button>
          <Button x:Name="ReloadButton" Width="36" Margin="0,0,4,0" Click="OnReloadClick"
                  ToolTip="Reload this page" AutomationProperties.Name="Reload">
            <ui:SymbolIcon Symbol="ArrowClockwise24" />
          </Button>
          <Button x:Name="HomeButton" Width="36" Margin="0,0,8,0" Click="OnHomeClick"
                  ToolTip="Open the selected bookmark's home page" AutomationProperties.Name="Home">
            <ui:SymbolIcon Symbol="Home24" />
          </Button>
        </StackPanel>

        <TextBox x:Name="AddressBox" Grid.Column="1" VerticalContentAlignment="Center"
                 Margin="0,0,8,0" KeyDown="OnAddressKeyDown" ToolTip="Address bar"
                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Address bar" />

        <TextBox x:Name="SearchBox" Grid.Column="2" Margin="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnSearchKeyDown"
                 ToolTip="Search the selected bookmark for a game (Enter also searches)" />

        <Button Grid.Column="3" Click="OnSearchClick"
                ToolTip="Search the selected bookmark for a game" AutomationProperties.Name="Search">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
            <TextBlock Text="Search" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- The bookmarks bar: one click to any saved site, exactly like a browser. -->
    <Border Grid.Row="1" Padding="6,4" Background="#12000000">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="SavePageButton" Click="OnSavePageClick" Margin="0,0,8,0"
                  ToolTip="Save the page you are on as a bookmark, with its search URL when one can be found"
                  AutomationProperties.Name="Save this page">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
              <TextBlock Text="Save this page" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Width="1" Background="#30FFFFFF" Margin="0,4,8,4" />

          <ItemsControl ItemsSource="{Binding Bookmarks}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,4,0" Click="OnBookmarkClick"
                        ToolTip="{Binding Tooltip}"
                        AutomationProperties.Name="{Binding Name}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter Property="Background" Value="#3DFFFFFF" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Star24" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="No bookmarks yet — browse somewhere and click Save this page"
                     VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.55" FontSize="12"
                     Visibility="{Binding HasBookmarks, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <wv2:WebView2 x:Name="Web" Grid.Row="2" />

    <!-- Empty state is a starting point, not a wall of dead buttons. -->
    <Border x:Name="EmptyState" Grid.Row="2" Background="#E6101010" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
        <TextBlock Text="No bookmarks yet" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85" TextAlignment="Center"
                   Text="Type an address above to browse to a game download site you have permission to use. Then click Save this page — 7SeasLauncher finds the site's search box and its name for you." />
        <Button Content="Save this page" HorizontalAlignment="Center" Margin="0,22,0,0"
                Click="OnSavePageClick" AutomationProperties.Name="Save this page" />
        <TextBlock x:Name="BookmarksFolderText" Margin="0,20,0,0" Opacity="0.45" FontSize="11" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
