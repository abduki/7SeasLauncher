<UserControl x:Class="SevenSeas.Launcher.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="4,4,4,12">
      <TextBlock Text="Jobs" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Command="{Binding ClearFinishedCommand}" Margin="0,0,8,0"
                ToolTip="Remove finished jobs from the list"
                AutomationProperties.Name="Clear finished jobs">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
            <TextBlock Text="Clear finished" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Click="OnRefreshClick" ToolTip="Re-read the job database"
                AutomationProperties.Name="Refresh jobs">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
      <StackPanel>
        <!-- In progress -->
        <TextBlock Text="In progress" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,8"
                   Visibility="{Binding HasActive, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Active}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8" Background="#1AFFFFFF">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Detail}" />
                    <TextBlock Text="{Binding UpdatedText}" HorizontalAlignment="Right"
                               Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Margin="0,3,0,9">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding StateText}" Opacity="0.75" FontSize="12" />
                      <TextBlock Text="{Binding SourceText}" Opacity="0.45" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Padding="10,2" FontSize="12"
                            Content="Stop"
                            ToolTip="Cancel this download"
                            AutomationProperties.Name="Stop download"
                            Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                  <ProgressBar Height="6" Maximum="100"
                               Value="{Binding Progress}"
                               IsIndeterminate="{Binding IsIndeterminate}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Recently finished -->
        <TextBlock Text="Recently finished" FontSize="15" FontWeight="SemiBold" Margin="4,14,0,8"
                   Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="8" Background="#0FFFFFFF">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding SourceText}" Opacity="0.4" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StateText}" Opacity="0.8" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding UpdatedText}" Opacity="0.45" FontSize="11" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="520" Margin="0,80,0,0" Visibility="Collapsed">
          <TextBlock Text="Nothing in the queue" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8" TextAlignment="Center"
                     Text="When you download a game, it shows up here while 7SeasLauncher checks, unpacks and registers it." />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
