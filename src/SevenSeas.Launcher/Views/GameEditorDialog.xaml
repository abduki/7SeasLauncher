<ui:FluentWindow x:Class="SevenSeas.Launcher.Views.GameEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Edit game"
        Width="620" SizeToContent="Height" MinHeight="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="DialogTitleBar" Title="Edit game" />

    <StackPanel Grid.Row="1" Margin="24,10,24,20">
      <TextBlock Text="Edit game" FontSize="19" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                 Text="Fix the name if 7SeasLauncher guessed it wrong — cover art is looked up again from the new name. You can also point the game at a different executable." />

      <TextBlock Text="Game title" FontWeight="SemiBold" Margin="0,20,0,6" />
      <TextBox x:Name="TitleBox" AutomationProperties.Name="Game title" />

      <TextBlock Text="Executable" FontWeight="SemiBold" Margin="0,18,0,6" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="ExeBox" Grid.Column="0" IsEditable="True"
                  AutomationProperties.Name="Executable"
                  ToolTip="Pick another executable from the game folder" />
        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClick"
                AutomationProperties.Name="Browse for executable" />
      </Grid>
      <TextBlock x:Name="HintText" Margin="0,6,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button Content="Save" MinWidth="110" Margin="0,0,8,0" IsDefault="True" Click="OnSaveClick"
                AutomationProperties.Name="Save game" />
        <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
