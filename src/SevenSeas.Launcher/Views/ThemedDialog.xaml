<ui:FluentWindow x:Class="SevenSeas.Launcher.Views.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="7SeasLauncher"
        Width="520" SizeToContent="Height" MinHeight="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="DialogTitleBar" Title="7SeasLauncher" />

    <StackPanel Grid.Row="1" Margin="24,10,24,20">
      <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8" />

      <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
