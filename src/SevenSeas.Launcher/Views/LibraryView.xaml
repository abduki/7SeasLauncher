<UserControl x:Class="SevenSeas.Launcher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="4,4,4,12">
      <TextBlock Text="Library" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefreshClick"
              ToolTip="Re-read the library database" AutomationProperties.Name="Refresh library">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
          <TextBlock Text="Refresh" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Right-click anywhere on the tile for the same actions. -->
            <Border Width="210" Margin="6" Padding="10" CornerRadius="10" Background="#1AFFFFFF">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Play" Command="{Binding LaunchCommand}" />
                  <MenuItem Header="Edit title or executable…" Command="{Binding EditCommand}" />
                  <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                  <Separator />
                  <MenuItem Header="Remove from library" Command="{Binding UninstallCommand}" />
                </ContextMenu>
              </Border.ContextMenu>

              <StackPanel>
                <Grid Height="250">
                  <Border CornerRadius="8" Background="#33000000">
                    <TextBlock Text="{Binding Initial}" FontSize="84" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                </Grid>

                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                           Margin="0,10,0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Opacity="0.75"
                           TextWrapping="Wrap" MinHeight="14" />

                <!-- One obvious action, the rest behind More. -->
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Button Grid.Column="0" Command="{Binding LaunchCommand}"
                          HorizontalContentAlignment="Center"
                          AutomationProperties.Name="Play" ToolTip="Launch this game">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Play24" Margin="0,0,6,0" />
                      <TextBlock Text="Play" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="1" Width="36" Margin="6,0,0,0" Click="OnTileMenuClick"
                          ToolTip="More actions" AutomationProperties.Name="More actions">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Empty state offers a way forward rather than instructions. -->
    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="520" Visibility="Collapsed">
      <TextBlock Text="Your library is empty" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8" TextAlignment="Center"
                 Text="Find a game on the Browse tab and click its download link. 7SeasLauncher verifies, unpacks and adds it here automatically." />
      <Button Content="Go to Browse" HorizontalAlignment="Center" Margin="0,20,0,0"
              Click="OnGoToBrowseClick" AutomationProperties.Name="Go to Browse" />
    </StackPanel>
  </Grid>
</UserControl>
